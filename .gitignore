node_modules/
dist/
content/data/*
!content/data/dictionary.json
# enable1 is read by tests/content-safety.test.ts (the gate that keeps slurs
# out of the shipped pools). Untracked, it passed locally and failed only in
# CI, which is the worst place to learn a safety gate is missing its corpus.
!content/data/enable1.txt
*.log

# ── Review / playtest scratch ──────────────────────────────────────────────
# Rounds 6–18 each left a heap of screenshots, JSON dumps and one-off driver
# scripts at the repo root, and three of them (.critic/, .playtest/,
# volume-1.sweep-backup.json) survived into the tree because nothing ignored
# them. A probe worth keeping gets a real name under scripts/; everything a
# round produces WHILE it runs belongs here.
.critic/
.editor/
.playtest/
*.scratch.test.ts
*.scratch.mjs
*.sweep-backup.json
vt-report.json
/*.png
