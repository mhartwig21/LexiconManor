{
  "name": "lexicon-loop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "content:dictionary": "tsx content/build-dictionary.ts",
    "content:hive": "tsx content/generate-hive.ts",
    "content:twistle": "tsx content/generate-twistle.ts",
    "content:all": "npm run content:dictionary && npm run content:hive && npm run content:twistle"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
